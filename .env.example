# Set DATABASE_URL to a PostgreSQL connection string for production.
# If empty, GeoRiesgo uses SQLite (georiesgo.db) for local evaluation.
DATABASE_URL=
# Example: postgresql://georiesgo:change-me@localhost:5432/georiesgo

# Optional stable Flask cookie signing key. Generate one with Python secrets.token_hex(32).
GEORIESGO_SECRET=
COOKIE_SECURE=0
PORT=5000

# Optional generative analysis. Without a key, the explainable local report is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
